load("@prelude//utils:source_listing.bzl", "source_listing")

oncall("build_infra")

source_listing()

prelude = native

# The two steps one-shot actions wrap around GHC, as one static binary: an
# action carries one file for them instead of a Python interpreter and its
# standard library. //tools:ghc_wrapper and //tools:ghc_pkg_registerer run it.
prelude.go_binary(
    name = "haskell_tool",
    # The binary and its standard library build without cgo. In a tree whose
    # platforms leave cgo on, prelude//go/tools:stdlib otherwise compiles C
    # with that tree's cxx toolchain; mercury-web-backend's nix cxx fails it
    # with "_FORTIFY_SOURCE requires compiling with optimization". go_binary's
    # transition sets prelude//go/constraints:cgo_enabled[false].
    cgo_enabled = False,
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//tools/..."],
)

prelude.go_test(
    name = "haskell_tool_test",
    srcs = glob(["*_test.go"]),
    embed_srcs = glob(["testdata/**"]),
    target_under_test = ":haskell_tool",
)
